# Biarkan kosong untuk mode demo. Gunakan gambar QRIS merchant yang benar.
# Contoh: salin QRIS resmi ke frontend/public/qris-toko.png
# lalu isi dengan /qris-toko.png
VITE_QRIS_IMAGE_URL=

VITE_API_URL=http://localhost:5000
# Demo saja, tidak memproses pembayaran sungguhan. Harus selaras dengan backend PAYMENT_MODE=demo.
VITE_DEMO_PAYMENTS=true
