PORT=5000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/matchaku
JWT_SECRET=GANTI_DENGAN_RAHASIA_PANJANG_ACAK
FRONTEND_URL=http://localhost:5173

# Opsional: tanpa key, chat berjalan dengan mode FAQ bawaan
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Keamanan checkout: default ditutup. Untuk simulasi gunakan PAYMENT_MODE=demo.
# Untuk transaksi asli: PAYMENT_MODE=live serta QRIS_MERCHANT_CONFIGURED=true
# (hanya setelah QRIS merchant benar-benar terpasang dan diverifikasi).
PAYMENT_MODE=demo
QRIS_MERCHANT_CONFIGURED=false

# Jadwal disimpan untuk waktu lokal Bali / WITA; opsional jam operasional jika sudah dikonfirmasi.
STORE_TIME_ZONE=Asia/Makassar
# STORE_OPEN_TIME=09:00
# STORE_CLOSE_TIME=20:00

# Delivery belum aktif sampai sistem area/ongkir tersedia.
